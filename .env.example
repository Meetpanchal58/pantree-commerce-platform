# Public origin of the browser-facing Pantree app. Use HTTPS in production.
PUBLIC_APP_URL=http://127.0.0.1:8000
APP_ENV=development

# Production Compose requires a real DNS name pointed at this server.
PUBLIC_APP_HOST=

# SuperTokens Core. For local Docker Compose use 127.0.0.1:3567.
# For an app container attached to docker-compose.auth.yml use http://supertokens:3567.
SUPERTOKENS_CONNECTION_URI=http://127.0.0.1:3567
SUPERTOKENS_API_KEY=

# Persistent PostgreSQL storage for the self-hosted SuperTokens Core.
SUPERTOKENS_DB_USER=supertokens
SUPERTOKENS_DB_PASSWORD=
SUPERTOKENS_DB_NAME=supertokens

# Live database. Leave empty to use the local SQLite file (webapp/pantree_app.db).
# Set to a Postgres connection string (e.g. Neon, with connection pooling) so accounts,
# carts, orders and activity survive restarts and redeploys. Never commit the real value.
DATABASE_URL=

# Production host paths: restore the existing pantree_app.db into the first directory,
# and make the raw warehouse parquet files available in the second directory.
PANTREE_DB_DIR=
PANTREE_DATA_DIR=

# Required in production; generate with a password manager or secret manager.
PANTREE_RATE_LIMIT_SECRET=

# Gmail SMTP uses implicit TLS on port 465. Use your full Gmail address for
# both SMTP_FROM_EMAIL and SMTP_USERNAME, and put the Google App Password in
# SMTP_PASSWORD. Never use your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=Pantree
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=

# Replace the example with the phone's current LAN IP; do not expose this port publicly.
OPENSMS_API_URL=http://192.168.1.50:9292/sms/
OPENSMS_API_KEY=
